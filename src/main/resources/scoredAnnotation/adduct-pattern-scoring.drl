package scoredAnnotation;

unit AdductPatternScoringUnit;

import scoredAnnotation.AdductPatternScoringUnit;

rule "Alanine relative M+H intensity"
when
    $scoredAnnotation: /scoredAnnotations[
        !hasCollectedAdductEvidence("alanine-[M+H]+"),
        hasCompoundName("alanine"),
        hasAdduct("[M+H]+")
    ]
then
    double observedRelativeIntensity = $scoredAnnotation.getRelativeAdductIntensity("[M+H]+");
    double score = AdductPatternScoringUnit.fuzzyScore(observedRelativeIntensity, 1.0);
    $scoredAnnotation.addAdductEvidenceScore("alanine-[M+H]+", score);
    update($scoredAnnotation);
end

