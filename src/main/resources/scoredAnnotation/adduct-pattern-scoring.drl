rule "No adduct hierarchy evidence collected"
salience -100
when
    $scoredAnnotation: /scoredAnnotations[scoreAdduct == null]
then
    $scoredAnnotation.setScoreAdduct(-1.0);
    update($scoredAnnotation);
end
